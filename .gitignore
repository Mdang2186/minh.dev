# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (all levels)
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Turbo
.turbo/

# Sentry
.sentry-debug-log

# Cache files
.cache/
*.sst
*.zst

# Scratch / temp files
scratch/
curl_output*.txt
old_roadmap.txt
project.json

# Embedded git repos / skills folders
ui-ux-pro-max-skill/

# ============================================================
# User-uploaded media — served via Vercel Blob on production.
# These files are large and must NOT be committed to git.
# ============================================================
apps/web/public/uploads/
apps/web/public/projects/
apps/web/public/Frontend_*.pdf